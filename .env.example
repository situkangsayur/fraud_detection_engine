# Copy to .env and change every value marked CHANGE_ME before any non-local deployment.
# Generate secrets with: openssl rand -hex 32

APP_VERSION=dev
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_DB=fraud
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_pg_superuser
MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator
CORE_API_DB_PASSWORD=CHANGE_ME_core_api
RULE_SERVICE_DB_PASSWORD=CHANGE_ME_rule_service
GRAPH_SERVICE_DB_PASSWORD=CHANGE_ME_graph_service
ML_SERVICE_DB_PASSWORD=CHANGE_ME_ml_service
LLM_SERVICE_DB_PASSWORD=CHANGE_ME_llm_service
INGEST_SERVICE_DB_PASSWORD=CHANGE_ME_ingest_service
POSTGRES_HOST_PORT=5433

# --- Security ---
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars_long
JWT_TTL_MINUTES=60
REFRESH_TTL_DAYS=14
WEB_SESSION_SECRET=CHANGE_ME_web_session_secret_32_chars_min
INTERNAL_API_TOKEN=CHANGE_ME_internal_service_token
PII_PEPPER=CHANGE_ME_pii_pepper_never_rotate_without_rehash
ADMIN_EMAIL=admin@fraud.local
ADMIN_PASSWORD=CHANGE_ME_admin_password
SESSION_COOKIE_SECURE=false

# --- Demo data (rules, rulesets, reference lists, demo users) ---
SEED_DEMO=true
DEMO_USER_PASSWORD=CHANGE_ME_demo_password

# --- ML ---
ML_TRAINING_WORKERS=2
MAX_UPLOAD_MB=200

# --- LLM ---
# Ollama endpoint. Default = the local "ollama" container, started by the "local-llm" compose profile.
# To use an existing server instead (e.g. the GPU host nvda11-gpu), remove local-llm from COMPOSE_PROFILES,
# set its URL and pick models it already has (`ollama list` on that host; bge-m3 must be pulled there too):
#   OLLAMA_URL=http://nvda11-gpu:11434          # or http://host.docker.internal:11434 for Ollama on this host
#   OLLAMA_CHAT_MODEL=qwen3:8b
COMPOSE_PROFILES=local-llm
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
# Thinking models (qwen3, deepseek-r1): false asks Ollama (>= 0.9) to skip reasoning; <think> is stripped anyway.
OLLAMA_THINK=
OPENSEARCH_HEAP=1g

# --- Network access ---
# Interface to publish on (0.0.0.0 = all interfaces, e.g. WireGuard 10.100.21.x + LAN).
BIND_ADDRESS=0.0.0.0
# Only these source networks may reach the web UI and the API (comma-separated CIDRs).
# Keep 172.31.250.0/24 (web BFF → gateway) and 172.31.251.1/32 (access from this host via the docker bridge).
ALLOWED_SOURCE_RANGES=10.100.21.0/24,192.168.1.0/24,172.31.250.0/24,172.31.251.1/32

# --- Published ports ---
GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000
OLLAMA_HOST_PORT=11434

# --- Simulator (docker compose --profile seed run --rm simulator) ---
SIM_TENANT=demo
SIM_CUSTOMERS=2000
SIM_DAYS=60
SIM_SEED=42
